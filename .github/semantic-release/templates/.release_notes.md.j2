{# GitHub Release body: Keep a Changelog sections, no version heading (the release title is the version). #}
{% set type_headings = {
  "Features": "Added",
  "Feature": "Added",
  "Bug Fixes": "Fixed",
  "Bug Fix": "Fixed",
  "Performance Improvements": "Changed",
  "Performance Improvement": "Changed",
} %}
{% set commit_objects = release["elements"] | dictsort %}
{% for type_, commits in commit_objects if type_ != "unknown" %}
{% set heading = type_headings[type_] if type_ in type_headings else type_ %}
{% set ns = namespace(lines=[]) %}
{% for commit in commits %}
{% if commit.descriptions %}
{% set summary = commit.descriptions[0] | trim %}
{% if summary %}
{% set ns.lines = ns.lines + ["- " ~ summary] %}
{% endif %}
{% endif %}
{% endfor %}
{% if ns.lines %}
### {{ heading }}

{{ ns.lines | unique | join("\n") }}

{% endif %}
{% endfor %}
