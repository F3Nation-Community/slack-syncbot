# SyncBot — Local Development
# Copy .env.example to .env
# For cloud deploys, see .env.deploy.example

LOCAL_DEVELOPMENT=true

# --- Database ---
# SQLite (zero setup):
DATABASE_BACKEND=sqlite
DATABASE_URL=sqlite:///syncbot.db

# MySQL/PostgreSQL (uncomment, configure, and replace SQLite above):
# DATABASE_BACKEND=
# DATABASE_HOST=
# DATABASE_PORT=
# DATABASE_USER=
# DATABASE_PASSWORD=
# DATABASE_SCHEMA=

# Optional TLS (provider-dependent)
# DATABASE_TLS_ENABLED=true
# DATABASE_SSL_CA_PATH=/etc/pki/tls/certs/ca-bundle.crt

# --- Slack ---
SLACK_BOT_TOKEN=
# Optional: use these to test OAuth flow locally
# SLACK_CLIENT_ID=
# SLACK_CLIENT_SECRET=
# SLACK_SIGNING_SECRET=

# --- External (optional, disabled by default) ---
# SYNCBOT_FEDERATION_ENABLED=false
# SYNCBOT_INSTANCE_ID=
# SYNCBOT_PUBLIC_URL=

# --- Optional ---
# DATA_ENCRYPTION_KEY=
LOG_LEVEL=DEBUG
REQUIRE_ADMIN=false
# PRIMARY_WORKSPACE=
# ENABLE_DB_RESET=true
# The next three are seed values for settings you can also change from the
# Settings modal in the Home tab. Once saved there, the saved value wins.
# SOFT_DELETE_RETENTION_DAYS=30
# ALLOW_PRIVATE_CHANNELS=false
# BROADCAST_ALLOWED_WORKSPACES=
