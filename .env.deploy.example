# Cloud deployment config — copy to .env.deploy.test or .env.deploy.prod.
# Used by ./deploy.sh --env test|prod
#
# For LOCAL DEVELOPMENT, use .env.example instead (cp .env.example .env).
#
# The default path assumes an existing database (e.g. TiDB Cloud) with a
# pre-created app user and schema. Set DATABASE_USER (full username) +
# DATABASE_PASSWORD. The stack does not CREATE USER / CREATE DATABASE.

# Cloud provider — allows ./deploy.sh --env test without specifying a provider.
CLOUD_PROVIDER=aws

# --- Provider: AWS (default) ---
AWS_REGION=us-east-2
STACK_NAME=syncbot-test
BOOTSTRAP_STACK_NAME=syncbot-bootstrap
# existing (default, TiDB / your MySQL or Postgres) or sqlite (Litestream → S3).
# Do not infer from DATABASE_HOST — this file always has a TiDB host.
AWS_DATABASE_MODE=existing
# EventBridge keep-warm every 5 minutes (portable name; also used on GCP).
ENABLE_KEEP_WARM=true

# --- Provider: GCP (uncomment if using GCP) ---
# CLOUD_PROVIDER=gcp
# GCP_PROJECT_ID=
# GCP_REGION=us-central1
# # Image: GCP_CLOUD_RUN_IMAGE preferred; CLOUD_RUN_IMAGE is a fallback. Blank = hello placeholder; CI replaces it.
# GCP_CLOUD_RUN_IMAGE=
# # CLOUD_RUN_IMAGE=
# # sqlite (default, Litestream + GCS) or existing (TiDB / other MySQL). Do not infer from DATABASE_HOST.
# GCP_DATABASE_MODE=sqlite
# # 0 = free/best-effort (default). 1 = paid always-on for Slack 3s. Only paid GCP default-adjacent knob.
# GCP_CLOUD_RUN_MIN_INSTANCES=0
# ENABLE_KEEP_WARM=true
# # owner/repo of THIS GitHub repo (the one with test/prod), for Workload Identity Federation
# GITHUB_REPO=

# Slack app credentials
SLACK_SIGNING_SECRET=
SLACK_CLIENT_SECRET=
SLACK_CLIENT_ID=

# Token encryption key (passed as SAM parameter / Terraform variable; not stored in cloud secret managers).
# Leave empty to auto-generate on first deploy (the value is saved back to this file).
DATA_ENCRYPTION_KEY=

# --- Database (existing / TiDB default on AWS) ---
# Create the database and app user first (see docs/DEPLOY.md). Pass the full
# DATABASE_USER (including any TiDB cluster prefix).
DATABASE_HOST=gateway.tidbcloud.com
DATABASE_PORT=4000
DATABASE_USER=
DATABASE_PASSWORD=
# MySQL/Postgres database name (Lambda DATABASE_SCHEMA). Convention: syncbot_<stage>
# (e.g. syncbot_test) so test/prod can share one host; must match grants for your app user.
DATABASE_SCHEMA=syncbot_test
DATABASE_ENGINE=mysql
DATABASE_TLS_ENABLED=true

# --- Optional: AWS sqlite + Litestream → S3 (instead of existing) ---
# AWS_DATABASE_MODE=sqlite
# DATABASE_ENGINE=sqlite
# (no DATABASE_HOST / USER / PASSWORD; pennies of S3; reserved concurrency 1)

# --- Bootstrap (one-time OIDC + SAM artifact bucket; use ./deploy.sh --env test --bootstrap) ---
# CREATE_OIDC_PROVIDER=true
# DEPLOY_BUCKET_PREFIX=syncbot-deploy

# --- Optional: OIDC deploy role ARN for ./deploy.sh --setup-github ---
# AWS_ROLE_ARN=

# --- Optional: target GitHub repo for --setup-github / CI/CD task (skips remote prompt) ---
# GITHUB_REPO=owner/repo

# --- Optional: SAM artifact bucket override (bootstrap stack output DeploymentBucketName) ---
# DEPLOYMENT_S3_BUCKET=

# --- Optional: resolve secrets from cloud Secret Manager ---
# Set *_SM_ID to reference an existing SM secret by name/ID.
# The deploy script fetches the value automatically (aws secretsmanager / gcloud secrets).
# Direct values (e.g. SLACK_SIGNING_SECRET=abc) take precedence over _SM_ID refs.
# SLACK_SIGNING_SECRET_SM_ID=syncbot/slack-signing-secret
# SLACK_CLIENT_SECRET_SM_ID=syncbot/slack-client-secret
# DATA_ENCRYPTION_KEY_SM_ID=syncbot/data-encryption-key
# DATABASE_PASSWORD_SM_ID=syncbot/db-password

# --- Optional app settings ---
# LOG_LEVEL=INFO
# REQUIRE_ADMIN=true
# SOFT_DELETE_RETENTION_DAYS=30
# PRIMARY_WORKSPACE=
# ENABLE_DB_RESET=
# SYNCBOT_FEDERATION_ENABLED=false
# SYNCBOT_INSTANCE_ID=
# SYNCBOT_PUBLIC_URL=
# ENABLE_XRAY=false
# Optional: skip sam deploy and use CloudFormation update-stack only (see docs/DEPLOY.md).
# UPDATE_STACK=true
